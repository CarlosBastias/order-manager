          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"order-manager\",uri!~\"/actuator.*\"}[5m])))",
          "legendFormat": "p95"
