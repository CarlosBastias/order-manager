          },
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"order-manager\",uri!~\"/actuator.*\"}[5m])))",
          "legendFormat": "p99"
