    {"id": 14, "type": "timeseries", "title": "Uso de CPU por réplica", "description": "CPU que usa el proceso de la app en cada réplica.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "process_cpu_usage{application=\"order-manager\"}", "legendFormat": "{{instance}}"}], "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"lineWidth": 2, "fillOpacity": 10}, "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}}},
    {"id": 15, "type": "timeseries", "title": "Memoria heap por réplica", "description": "Memoria heap de la JVM usada vs. el máximo permitido.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "sum by (instance) (jvm_memory_used_bytes{application=\"order-manager\",area=\"heap\"})", "legendFormat": "usada {{instance}}"}, {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "B", "expr": "sum by (instance) (jvm_memory_max_bytes{application=\"order-manager\",area=\"heap\"})", "legendFormat": "máximo {{instance}}"}], "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}}},
    {"id": 16, "type": "row", "title": "Negocio", "collapsed": false, "gridPos": {"x": 0, "y": 32, "w": 24, "h": 1}, "panels": []},
    {"id": 17, "type": "timeseries", "title": "Pedidos creados por minuto", "description": "Ritmo de creación de pedidos.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 33, "w": 12, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "sum(rate(ordermanager_orders_placed_total{application=\"order-manager\"}[1m])) * 60", "legendFormat": "pedidos/min"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}}},
    {"id": 18, "type": "timeseries", "title": "Cambios de estado de pedidos", "description": "Pedidos que pasaron a cada estado en los últimos 5 minutos.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 33, "w": 12, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "sum by (to) (increase(ordermanager_orders_status_changes_total{application=\"order-manager\"}[5m]))", "legendFormat": "{{to}}"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}}}
