      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Latencia (p50 / p95 / p99)",
      "description": "Tiempo de respuesta de la API.",
      "datasource": {
        "type": "prometheus",
