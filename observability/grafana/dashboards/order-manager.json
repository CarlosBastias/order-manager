    {"id": 2, "type": "stat", "title": "Réplicas disponibles", "description": "Réplicas de la app que responden a Prometheus (up=1).", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 1, "w": 4, "h": 5}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "sum(up{job=\"order-manager\"})", "legendFormat": ""}], "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 1}, {"color": "green", "value": 2}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area", "textMode": "value"}},
    {"id": 3, "type": "stat", "title": "Disponibilidad (1h)", "description": "Porcentaje del tiempo en que las réplicas estuvieron arriba en la última hora.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 4, "y": 1, "w": 4, "h": 5}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "100 * avg(avg_over_time(up{job=\"order-manager\"}[1h]))", "legendFormat": ""}], "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 95}, {"color": "green", "value": 99}]}, "decimals": 2}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area", "textMode": "value"}},
    {"id": 4, "type": "stat", "title": "Peticiones por segundo", "description": "Tráfico a la API (sin contar /actuator).", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 8, "y": 1, "w": 4, "h": 5}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{application=\"order-manager\",uri!~\"/actuator.*\"}[1m]))", "legendFormat": ""}], "fieldConfig": {"defaults": {"unit": "reqps", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "decimals": 2}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area", "textMode": "value"}},
    {"id": 5, "type": "stat", "title": "Tasa de errores 5xx", "description": "Porcentaje de peticiones que terminaron en error del servidor.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 1, "w": 4, "h": 5}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "100 * (sum(rate(http_server_requests_seconds_count{application=\"order-manager\",uri!~\"/actuator.*\",status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"order-manager\",uri!~\"/actuator.*\"}[5m])), 0.0001)", "legendFormat": ""}], "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}]}, "decimals": 2}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area", "textMode": "value"}},
    {"id": 6, "type": "stat", "title": "Latencia p95", "description": "El 95% de las peticiones responde en menos de este tiempo.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 16, "y": 1, "w": 4, "h": 5}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"order-manager\",uri!~\"/actuator.*\"}[5m])))", "legendFormat": ""}], "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.5}, {"color": "red", "value": 1}]}, "decimals": 3}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area", "textMode": "value"}},
    {"id": 7, "type": "stat", "title": "Pedidos creados (total)", "description": "Pedidos creados desde que arrancaron las réplicas.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 20, "y": 1, "w": 4, "h": 5}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "sum(ordermanager_orders_placed_total{application=\"order-manager\"})", "legendFormat": ""}], "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area", "textMode": "value"}},
    {"id": 8, "type": "timeseries", "title": "Peticiones por segundo por estado HTTP", "description": "Tráfico separado por código de respuesta.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 6, "w": 12, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"order-manager\",uri!~\"/actuator.*\"}[1m]))", "legendFormat": "HTTP {{status}}"}], "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}}},
    {"id": 9, "type": "timeseries", "title": "Latencia (p50 / p95 / p99)", "description": "Tiempo de respuesta de la API.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 6, "w": 12, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"order-manager\",uri!~\"/actuator.*\"}[5m])))", "legendFormat": "p50"}, {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"order-manager\",uri!~\"/actuator.*\"}[5m])))", "legendFormat": "p95"}, {"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"order-manager\",uri!~\"/actuator.*\"}[5m])))", "legendFormat": "p99"}], "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}}},
    {"id": 10, "type": "row", "title": "Errores registrados", "collapsed": false, "gridPos": {"x": 0, "y": 14, "w": 24, "h": 1}, "panels": []},
    {"id": 11, "type": "timeseries", "title": "Errores por tipo (últimos 5 min)", "description": "Errores manejados por la app, separados por tipo (not_found, invalid_state, validation, bad_request, internal).", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 0, "y": 15, "w": 12, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "sum by (type) (increase(ordermanager_errors_total{application=\"order-manager\"}[5m]))", "legendFormat": "{{type}}"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}}},
    {"id": 12, "type": "bargauge", "title": "Errores acumulados por tipo", "description": "Total de errores registrados desde que arrancaron las réplicas.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"x": 12, "y": 15, "w": 12, "h": 8}, "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "refId": "A", "expr": "sum by (type, status) (ordermanager_errors_total{application=\"order-manager\"})", "legendFormat": "{{type}} ({{status}})"}], "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "orange", "value": null}]}}, "overrides": []}, "options": {}},
